{
  "manifest_version": 3,
  "name": "Recipe Matrix",
  "version": "1.0.0",
  "description": "Convert any recipe page into a Cooking for Engineers-style tabular recipe chart. Edit, theme, and export as PNG or PDF.",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel", "clipboardWrite", "downloads"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Recipe Matrix — chart this recipe",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
